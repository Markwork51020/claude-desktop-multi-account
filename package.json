{
  "name": "claude-multi",
  "productName": "Claude Multi",
  "version": "1.3.0",
  "description": "Run multiple Claude Desktop accounts at the same time on Windows: separate logins, email sign-in links routed to the right window, shared project, MCP and Claude Code history",
  "keywords": [
    "claude",
    "claude-desktop",
    "claude-code",
    "anthropic",
    "multi-account",
    "multiple-accounts",
    "multi-instance",
    "мультиаккаунт",
    "多开",
    "多账号",
    "account-switcher",
    "windows",
    "electron"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Markwork51020/claude-desktop-multi-account#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Markwork51020/claude-desktop-multi-account.git"
  },
  "bugs": {
    "url": "https://github.com/Markwork51020/claude-desktop-multi-account/issues"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . ClaudeMulti --platform=win32 --arch=x64 --out=dist --overwrite --asar --icon=icon.ico --ignore=^/dist"
  },
  "devDependencies": {
    "@electron/packager": "18.3.6",
    "electron": "33.2.1"
  }
}
